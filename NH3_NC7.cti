"""
Development of a reduced chemical mechanism for ammonia/n-heptane blends
"""

units(length='cm', time='s', quantity='mol', act_energy='cal/mol')

ideal_gas(name='gas',
          elements="C H N O Ar He",
          species="""AR          N2          HE          H2
                     H           O2          O           H2O
                     OH          H2O2        HO2         CO
                     CO2         CH3O2       CH3O        CH2O
                     CH2OH       CH4         CH3         CH2
                     CH2(S)      HCO         C2H6        C2H5
                     C2H5O2      C2H4        C2H3        C2H2
                     CH2CHO      CH2CO       HCCO        NC3H7
                     NC3H7O2     C3H6        C3H5-A      C3H5O
                     C3H4-A      NC7H16      C7H15       C7H15O2
                     C7H14OOH    C7H14       C7H14OOHO2  NC7KET
                     NC7KETO     C7H14O      NC3H7CHO    NC3H7CO
                     NH3         NH2         NH          N
                     NNH         N2H4        N2H3        N2H2
                     H2NN        H2NO        HNOH        HNO
                     HONO        NO          NO2         N2O
                     HCN         CN          HNCO        HOCN
                     NCO         CH3NH2      CH2NH2      CH2NH
                     H2CN        HCNH""",
          reactions='all',
          transport='Mix',
          initial_state=state(temperature=300.0, pressure=OneAtm))

