domainLength=2.50e-03		#in meters
Rd=50.0e-6               #droplet radius, in meters
constantPressure=1		#1=isobaric, 0=isochoric
dPdt=0.0e0			#Units: Pa/s
problemType=2			#0=heatsource to ignite(premix),1=premix, 2=custom initial condition
reflectProblem=0		#If 1, the initial conditions are reflected across the center of the domain. Useful for spherically imploding flames for instance.
mdot=0.0
initialTemperature=850.0	#in Kelvin
initialPressure=20.0		#in atmospheres
chemistryFile=./NH3_NC7.xml
transportModel=Mix		#Transport model
mixtureComposition=NO2:0.1,O2:20.586,N2:77.443	#Mole Fractions!
dropletComposition=NC7H16
rxn=1
metric=2			#0=planar,1=cylindrical,2=spherical
ignTime=9e-04			#Time over which energy is supplied in seconds
QDot=0.0			#Power supplied in units of W/m3
mixingWidth=0.6e-03		#mixing layer width in m (for diffusion problem)
shift=2e-03 	#shift of mixing layer into domain (for diffusion problem)
firstRadius=0.0
dirichletInner=0		#Boundary conditions for scalars (T,Y)
dirichletOuter=1
wallTemperature=900.0
adaptiveGrid=0
moveGrid=0
Rg=20
gridOffset=0
gasBasePts=1001
liquidBasePts=101
gridDensitySlope=70.0e0
fineGridHalfWidth=8e-03
gridRefinement=1000.0e0
leftRefineFactor=0.01
rightRefineFactor=0.01
refineLeft=1
refineRight=1
position=0.0
isotherm=1500.0
nSaves=20            	#Save solution every nSaves timesteps
writeEveryRegrid=0
writeRates=0
relativeTolerance=1e-03
radiusTolerance=1e-06		#absolute tolerance for radius
temperatureTolerance=1e-06
pressureTolerance=1e-06
massFractionTolerance=1e-09
bathGasTolerance=1e-06
finalTime=1.0			#in seconds
deltaT=5.0e-6
setConstraints=0
suppressAlg=0
nThreads=0
printYdot=0
printY=0
dryRun=0
